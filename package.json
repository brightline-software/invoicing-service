{
  "name": "invoicing-service",
  "version": "2.14.0",
  "private": true,
  "type": "module",
  "description": "Brightline invoicing service: creates invoices, sends them through Hermes, exports orders.",
  "engines": { "node": ">=20.11 <21" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/hermes/worker.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "db:migrate": "node-pg-migrate -m db/migrations up",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "bullmq": "^5.7.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "eslint": "^8.57.0",
    "node-pg-migrate": "^7.4.0",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
