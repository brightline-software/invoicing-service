# Copy to .env and fill in. Never commit .env.
PORT=4100
DATABASE_URL=postgres://invoicing:invoicing@localhost:5432/invoicing
# Hermes = the invoicing queue (Redis-backed)
HERMES_URL=redis://localhost:6379
HERMES_QUEUE=invoices
# Atlas = the API gateway. Locally we skip the signature check with a dev token.
ATLAS_DEV_TOKEN=local-dev-only
ATLAS_PUBLIC_KEY=
MAILER_API_KEY=
INVOICE_CRON=0 6 * * *
